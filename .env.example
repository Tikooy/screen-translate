# 在线翻译小工具 配置模板
# 复制为 .env 并填写真实值（也可以直接在应用右上角"设置"里填写，无需手动编辑本文件）

# 翻译引擎（deepl | google | openai，openai 为 OpenAI 兼容接口，可接 ChatGPT/DeepSeek/通义等）
TRANSLATE_PROVIDER=deepl

# DeepL API Key（https://www.deepl.com/pro-api 注册后获取）
DEEPL_API_KEY=your_deepl_api_key

# Google Cloud Translation API Key（v2 API）
GOOGLE_API_KEY=

# OpenAI 兼容接口：API Key / Base URL / 模型
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini

# 服务监听地址与端口（桌面窗口会加载 http://127.0.0.1:<PORT>）
HOST=127.0.0.1
PORT=8765

# OCR 语言（ch=中英混合；如需 50 语言可改 en 等，见 PaddleOCR 文档）
OCR_LANG=ch
# OCR 推理设备（cpu 或 gpu；gpu 需安装 GPU 版 PaddlePaddle）
OCR_DEVICE=cpu

# 取词翻译的全局热键（keyboard 库按键写法，任意应用选中文字后按下即可划词翻译）
# 注意避开 Ctrl+Shift+T（浏览器"重新打开标签页"）
WORD_PICK_HOTKEY=ctrl+alt+t
# 取词（热键）翻译的目标语言（DeepL 代码：ZH=简体中文，EN=英语，JA=日语，KO=韩语）
WORD_PICK_LANG=ZH
# 区域翻译的变化检测轮询间隔（秒），开始后每隔该秒数重新截图+OCR 一次
REGION_POLL_INTERVAL=2.0
# 点击主窗口 × 是否直接退出（true=直接退出；false=最小化到托盘）
EXIT_ON_CLOSE=false
